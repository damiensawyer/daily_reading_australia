# ElevenLabs text-to-speech configuration — daily readings
#
# This is a TEMPLATE. Copy values into your real config by running:
#
#     ./setup.sh
#
# The real file (with your API key) is written OUTSIDE this repo, to
# ~/.config/daily-reading/env (or a stow-managed equivalent) and is never
# committed. Alternatively create ./env here — it is gitignored too.

# Required. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice: an ElevenLabs voice ID (setup.sh saves the ID here) or a voice
# name (e.g. rachel, brian, charlotte).
# See the voices available to your account:  ./tts_daily_reading.sh --list-voices
ELEVENLABS_VOICE=rachel

# Name of the voice above, written by setup.sh. Used to name the output mp3
# (audio/YYYY-MM-DD-<voice>.mp3); looked up via the API when not set.
ELEVENLABS_VOICE_NAME=Rachel

# Model:
#   eleven_flash_v2_5         — fast & cheap, very good quality (default)
#   eleven_multilingual_v2    — highest quality, uses ~10x more credits
#   eleven_v3                 — most expressive (may need a paid tier)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# MP3 output format: codec_samplerate_bitrate.
#   mp3_44100_64  — 64 kbps, small file, fine for speech (default)
#   mp3_44100_96  — a bit richer
#   mp3_44100_128 — near-transparent, larger
# Bitrates of 192 kbps+ require a Creator (or higher) subscription.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_64

# Voice tuning (0.0–1.0). Defaults suit readings: steady, consistent.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_SPEAKER_BOOST=true

# Where generated mp3s are written (default: ./audio in this repo)
#AUDIO_DIR=
